<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="HR_Dept.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>    
        <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    </title>
    <link href="Styles/StyleSheet1.css" rel="stylesheet" type ="text/css"/>
</head>
<body>
    <form id="form1" runat="server">
    <header>
        <%--<img id="logo" src="Images/logo.png"/>--%>
    </header>
    <nav>
        <asp:Menu ID="Menu1" runat="server" CssClass="nav" DataSourceID="SiteMapDataSource1" Orientation="Horizontal" StaticDisplayLevels="2" StaticSubMenuIndent="0px">
        </asp:Menu>
        <asp:SiteMapDataSource ID="SiteMapDataSource1" runat="server" />
    </nav>
    <div id ="content">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
